<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>NextLevel Super AI | Autonomous Security Operations</title>
  
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;800;900&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">
  
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            orbitron: ['Orbitron', 'sans-serif'],
            rajdhani: ['Rajdhani', 'sans-serif'],
          },
          colors: {
            cyber: {
              base: '#050a15',
              panel: 'rgba(10, 20, 40, 0.75)',
              cyan: '#00f2fe',
              blue: '#4facfe',
              red: '#ff003c',
              green: '#00ff88',
            }
          }
        }
      }
    }
  </script>
  
  <style>
    body {
      background-color: #050a15;
      color: #ffffff;
      background-image: 
        radial-gradient(circle at 15% 50%, rgba(0, 242, 254, 0.08) 0%, transparent 50%),
        radial-gradient(circle at 85% 30%, rgba(79, 172, 254, 0.08) 0%, transparent 50%);
      overflow-x: hidden;
    }

    .glass-panel {
      background: rgba(10, 20, 40, 0.75);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(0, 242, 254, 0.2);
      box-shadow: 0 4px 30px rgba(0, 0, 0, 0.6);
    }

    .glow-cyan {
      text-shadow: 0 0 10px rgba(0, 242, 254, 0.8), 0 0 20px rgba(0, 242, 254, 0.4);
    }

    .glow-red {
      text-shadow: 0 0 10px rgba(255, 0, 60, 0.8), 0 0 20px rgba(255, 0, 60, 0.4);
    }

    .cyber-btn {
      background: linear-gradient(90deg, rgba(0,242,254,0.15) 0%, rgba(79,172,254,0.15) 100%);
      border: 1px solid #00f2fe;
      box-shadow: 0 0 15px rgba(0, 242, 254, 0.3) inset, 0 0 20px rgba(0, 242, 254, 0.2);
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
    }

    .cyber-btn:hover {
      box-shadow: 0 0 25px rgba(0, 242, 254, 0.6) inset, 0 0 30px rgba(0, 242, 254, 0.6);
      text-shadow: 0 0 8px #fff;
    }

    .cyber-grid {
      position: absolute;
      inset: 0;
      background-size: 40px 40px;
      background-image: 
        linear-gradient(to right, rgba(0, 242, 254, 0.04) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(0, 242, 254, 0.04) 1px, transparent 1px);
      z-index: -1;
      pointer-events: none;
    }

    .sim-row { transition: all 0.4s ease; }
    .sim-row.critical {
      background: rgba(255, 0, 60, 0.15) !important;
      border-color: #ff003c !important;
    }

    @keyframes pulseAlert {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }
    .alert-blink { animation: pulseAlert 1.2s infinite; }
  </style>
</head>
<body class="font-rajdhani antialiased relative min-h-screen flex flex-col">

  <div class="cyber-grid"></div>

  <!-- NAVIGATION -->
  <header class="glass-panel sticky top-0 z-50 border-b border-cyber-cyan/30 py-4 px-6 md:px-12 flex justify-between items-center">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-full border border-cyber-cyan flex items-center justify-center shadow-[0_0_10px_#00f2fe]">
        <div class="w-2.5 h-2.5 bg-cyber-cyan rounded-full animate-ping"></div>
      </div>
      <h1 class="font-orbitron font-bold text-lg md:text-xl tracking-wider">
        NEXT<span class="text-cyber-cyan glow-cyan">LEVEL</span> SUPER AI
      </h1>
    </div>
    <div class="flex items-center gap-4">
      <div class="hidden sm:flex items-center gap-2 px-3 py-1 rounded bg-black/40 border border-cyber-cyan/20 text-xs font-mono">
        <span class="w-2 h-2 rounded-full bg-cyber-green animate-pulse"></span>
        <span class="text-gray-300">CORE STATUS: OPTIMAL</span>
      </div>
    </div>
  </header>

  <!-- MAIN HERO -->
  <main class="flex-grow">
    <section class="relative pt-16 pb-12 px-6 text-center z-10 max-w-4xl mx-auto">
      <div class="inline-block border border-cyber-cyan/40 bg-cyber-cyan/10 text-cyber-cyan font-orbitron px-4 py-1 rounded-full text-xs md:text-sm mb-6 tracking-widest shadow-[0_0_10px_rgba(0,242,254,0.2)]">
        AUTONOMOUS CYBER DEFENSE PIPELINE
      </div>
      <h2 class="text-4xl md:text-6xl font-orbitron font-black mb-6 leading-tight">
        REAL-TIME TELEMETRY.<br>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyber-cyan to-cyber-blue glow-cyan">
          ZERO-LATENCY DEFENSE.
        </span>
      </h2>
      <p class="text-lg md:text-xl text-gray-400 mb-8 max-w-2xl mx-auto">
        Continuous risk assessment, protocol compliance, and policy-driven threat isolation engineered for high-throughput enterprise infrastructure.
      </p>
    </section>

    <!-- LIVE MONITORING TABLE -->
    <section class="pb-16 px-6 z-10 max-w-5xl mx-auto">
      <div class="glass-panel rounded-xl border border-cyber-cyan/30 overflow-hidden">
        
        <!-- Table Control Bar -->
        <div class="bg-black/60 p-4 border-b border-cyber-cyan/20 flex flex-wrap justify-between items-center gap-2">
          <div class="flex items-center gap-2 font-mono text-xs text-cyber-cyan">
            <span class="w-2 h-2 rounded-full bg-cyber-green animate-pulse"></span>
            ACTIVE NETWORK TOPOLOGY
          </div>
          <div class="text-xs text-gray-400 font-mono" id="sim-clock">00:00:00:000</div>
        </div>

        <!-- Table Data -->
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse font-mono text-xs md:text-sm">
            <thead>
              <tr class="bg-cyber-cyan/5 text-cyber-cyan border-b border-cyber-cyan/20">
                <th class="p-3.5 uppercase">Node</th>
                <th class="p-3.5 uppercase">Address</th>
                <th class="p-3.5 uppercase">Bandwidth</th>
                <th class="p-3.5 uppercase">Threat Score</th>
                <th class="p-3.5 uppercase text-right">Policy Status</th>
              </tr>
            </thead>
            <tbody id="sim-tbody">
              <!-- Safe Node 1 -->
              <tr class="border-b border-cyber-cyan/10 hover:bg-white/5 transition-colors">
                <td class="p-3.5 font-semibold text-gray-200">Gateway-Alpha</td>
                <td class="p-3.5 text-gray-400">192.168.1.1</td>
                <td class="p-3.5 text-gray-300">1.4 Gbps</td>
                <td class="p-3.5 text-cyber-green">0.2% [PASS]</td>
                <td class="p-3.5 text-right"><span class="px-2 py-0.5 bg-cyber-green/20 text-cyber-green rounded border border-cyber-green/40 text-xs">ALLOWED</span></td>
              </tr>

              <!-- Dynamic Simulation Node -->
              <tr id="target-row" class="sim-row border-b border-cyber-cyan/10 bg-cyber-cyan/5">
                <td class="p-3.5 font-bold text-white flex items-center gap-2">
                  <span id="target-icon">
                    <svg class="w-4 h-4 text-cyber-cyan animate-spin" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                  </span>
                  Ext-Ingress-04
                </td>
                <td class="p-3.5 text-gray-400">10.0.12.89</td>
                <td class="p-3.5 font-semibold" id="target-traffic">45.2 Mbps</td>
                <td class="p-3.5 font-semibold" id="target-risk"><span class="text-cyber-cyan">Evaluating...</span></td>
                <td class="p-3.5 text-right" id="target-status">
                  <span class="px-2 py-0.5 bg-cyber-cyan/20 text-cyber-cyan rounded border border-cyber-cyan/40 text-xs animate-pulse">MONITORING</span>
                </td>
              </tr>

              <!-- Safe Node 2 -->
              <tr class="hover:bg-white/5 transition-colors">
                <td class="p-3.5 font-semibold text-gray-200">Auth-Cluster-DB</td>
                <td class="p-3.5 text-gray-400">10.0.4.15</td>
                <td class="p-3.5 text-gray-300">8.1 Mbps</td>
                <td class="p-3.5 text-cyber-green">1.1% [PASS]</td>
                <td class="p-3.5 text-right"><span class="px-2 py-0.5 bg-cyber-green/20 text-cyber-green rounded border border-cyber-green/40 text-xs">ALLOWED</span></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </main>

  <!-- FOOTER -->
  <footer class="border-t border-cyber-cyan/20 bg-[#02050a] py-6 px-6 z-10 text-xs font-mono text-gray-400">
    <div class="max-w-5xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-3">
      <div>NEXTLEVEL SUPER AI ARCHITECTURE &bull; 2026</div>
      <div class="text-cyber-cyan">SYSTEM ACTIVE &bull; STANDBY MODE</div>
    </div>
  </footer>

  <!-- SCRIPT -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Clock synchronization
      const clockEl = document.getElementById('sim-clock');
      setInterval(() => {
        const d = new Date();
        clockEl.textContent = `${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}:${String(d.getSeconds()).padStart(2,'0')}.${String(d.getMilliseconds()).padStart(3,'0')}`;
      }, 50);

      // Controlled state simulation cycle
      const row = document.getElementById('target-row');
      const icon = document.getElementById('target-icon');
      const traffic = document.getElementById('target-traffic');
      const risk = document.getElementById('target-risk');
      const status = document.getElementById('target-status');

      function cycleState() {
        // State 1: Reset to baseline
        row.className = 'sim-row border-b border-cyber-cyan/10 bg-cyber-cyan/5';
        icon.innerHTML = `<svg class="w-4 h-4 text-cyber-cyan animate-spin" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>`;
        traffic.innerHTML = '<span class="text-cyber-cyan">45.2 Mbps</span>';
        risk.innerHTML = '<span class="text-cyber-cyan">Evaluating...</span>';
        status.innerHTML = '<span class="px-2 py-0.5 bg-cyber-cyan/20 text-cyber-cyan rounded border border-cyber-cyan/40 text-xs animate-pulse">MONITORING</span>';

        // State 2: Anomaly Flagged (after 3s)
        setTimeout(() => {
          risk.innerHTML = '<span class="text-cyber-red glow-red font-bold alert-blink">92.4% [CRITICAL]</span>';
        }, 3000);

        // State 3: Isolated (after 5s)
        setTimeout(() => {
          row.classList.add('critical');
          icon.innerHTML = `<svg class="w-4 h-4 text-cyber-red" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>`;
          traffic.innerHTML = '<span class="text-cyber-red font-bold">0.0 Mbps [BLOCKED]</span>';
          status.innerHTML = '<span class="px-2 py-0.5 bg-cyber-red text-white font-bold rounded text-xs shadow-[0_0_10px_#ff003c]">ISOLATED</span>';
        }, 5000);
      }

      cycleState();
      setInterval(cycleState, 11000);
    });
  </script>
</body>
</html>