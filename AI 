  <style>
    :root {
      --bg-app: #06070d;
      --bg-sidebar: rgba(11, 13, 24, 0.88);
      --bg-card: rgba(16, 20, 36, 0.72);
      --bg-card-hover: rgba(24, 30, 54, 0.88);
      --border-subtle: rgba(139, 92, 246, 0.16);
      --border-strong: rgba(139, 92, 246, 0.36);
      --text-primary: #f4f6ff;
      --text-secondary: #98a2c3;
      --text-muted: #646f94;
      --accent-violet: #8b5cf6;
      --accent-cyan: #06b6d4;
      --accent-emerald: #10b981;
    }

    html.light-theme {
      --bg-app: #f4f6fb;
      --bg-sidebar: rgba(255, 255, 255, 0.92);
      --bg-card: rgba(255, 255, 255, 0.88);
      --bg-card-hover: #ffffff;
      --border-subtle: rgba(15, 23, 42, 0.09);
      --border-strong: rgba(124, 58, 237, 0.3);
      --text-primary: #0f172a;
      --text-secondary: #475569;
      --text-muted: #64748b;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background-color: var(--bg-app);
      color: var(--text-primary);
      font-family: 'DM Sans', sans-serif;
      overflow-x: hidden;
      background-image:
        radial-gradient(circle at 15% 10%, rgba(139, 92, 246, 0.12), transparent 38%),
        radial-gradient(circle at 85% 20%, rgba(6, 182, 212, 0.1), transparent 36%),
        radial-gradient(circle at 50% 90%, rgba(16, 185, 129, 0.07), transparent 42%);
      background-attachment: fixed;
    }

    html.light-theme body {
      background-image:
        radial-gradient(circle at 15% 10%, rgba(139, 92, 246, 0.07), transparent 40%),
        radial-gradient(circle at 85% 20%, rgba(6, 182, 212, 0.07), transparent 40%);
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(139, 92, 246, 0.28);
      border-radius: 999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: rgba(139, 92, 246, 0.5);
    }

    .glass-panel {
      background: var(--bg-card);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: 1px solid var(--border-subtle);
      transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .glass-panel:hover {
      border-color: var(--border-strong);
    }

    .sidebar-shell {
      background: var(--bg-sidebar);
      backdrop-filter: blur(22px);
      -webkit-backdrop-filter: blur(22px);
      border-right: 1px solid var(--border-subtle);
    }

    .antimatter-gradient-text {
      background: linear-gradient(135deg, #c4b5fd 0%, #38bdf8 50%, #34d399 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    html.light-theme .antimatter-gradient-text {
      background: linear-gradient(135deg, #6d28d9 0%, #0284c7 55%, #059669 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .antimatter-btn {
      background: linear-gradient(135deg, #7c3aed 0%, #2563eb 55%, #0891b2 100%);
      color: #ffffff;
      box-shadow: 0 8px 26px -6px rgba(124, 58, 237, 0.55);
      transition: transform 0.18s ease, box-shadow 0.18s ease, filter 0.18s ease;
    }

    .antimatter-btn:hover {
      transform: translateY(-1px);
      box-shadow: 0 12px 30px -4px rgba(6, 182, 212, 0.5);
      filter: brightness(1.07);
    }

    .antimatter-btn:active {
      transform: translateY(0px);
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 0.7rem;
      width: 100%;
      padding: 0.62rem 0.85rem;
      border-radius: 0.8rem;
      font-size: 0.88rem;
      font-weight: 500;
      color: var(--text-secondary);
      transition: all 0.16s ease;
      text-align: left;
      border: 1px solid transparent;
    }

    .nav-item:hover {
      color: var(--text-primary);
      background: rgba(139, 92, 246, 0.1);
    }

    .nav-item.active {
      color: #ffffff;
      background: linear-gradient(90deg, rgba(139, 92, 246, 0.24), rgba(6, 182, 212, 0.12));
      border-color: rgba(139, 92, 246, 0.38);
      font-weight: 600;
    }

    html.light-theme .nav-item.active {
      color: #4c1d95;
      background: linear-gradient(90deg, rgba(139, 92, 246, 0.14), rgba(6, 182, 212, 0.08));
    }

    .page-view {
      display: none;
      animation: fadeSlideIn 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .page-view.active {
      display: block;
    }

    @keyframes fadeSlideIn {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Typing dots */
    .typing-dot {
      width: 6px;
      height: 6px;
      border-radius: 999px;
      background: #38bdf8;
      display: inline-block;
      animation: bounceDot 1.3s infinite ease-in-out both;
    }
    .typing-dot:nth-child(1) { animation-delay: -0.32s; }
    .typing-dot:nth-child(2) { animation-delay: -0.16s; }
    @keyframes bounceDot {
      0%, 80%, 100% { transform: scale(0.4); opacity: 0.4; }
      40% { transform: scale(1); opacity: 1; }
    }

    /* Code markdown styling inside chat */
    .chat-prose pre {
      background: rgba(5, 6, 12, 0.9);
      border: 1px solid rgba(139, 92, 246, 0.25);
      border-radius: 0.75rem;
      padding: 0.85rem 1rem;
      overflow-x: auto;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.8rem;
      color: #e2e8f0;
      margin: 0.65rem 0;
    }
    .chat-prose code {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.82em;
      background: rgba(139, 92, 246, 0.16);
      padding: 0.12rem 0.35rem;
      border-radius: 0.35rem;
    }
    .chat-prose pre code {
      background: transparent;
      padding: 0;
    }
  </style>
</head>
