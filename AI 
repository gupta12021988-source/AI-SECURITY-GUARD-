        <form onsubmit="event.preventDefault(); this.querySelector('button').textContent='✓ Request Confirmed!';" class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto pt-2">
          <input type="email" required placeholder="you@domain.com" class="flex-1 px-4 py-3 rounded-xl text-sm glass focus:outline-none" />
          <button type="submit" class="cta-btn px-6 py-3 rounded-xl font-bold text-sm cursor-pointer">Request Access</button>
        </form>
      </div>
    </section>
  </main>

  <footer class="border-t py-8 text-center text-xs opacity-60" style="border-color:${t.border}">
    © ${new Date().getFullYear()} ${safeName} · Synthesized with NextLevel Super AI Antimatter Engine
  </footer>
</body>
</html>`;
    }

    function switchBuilderView(view) {
      const iframe = document.getElementById('site-preview');
      const codeArea = document.getElementById('site-code-view');
      const prevBtn = document.getElementById('tab-preview-btn');
      const codeBtn = document.getElementById('tab-code-btn');

      if (view === 'preview') {
        iframe.classList.remove('hidden');
        codeArea.classList.add('hidden');
        prevBtn.className = 'px-2.5 py-1 rounded-md bg-violet-600 text-white font-semibold cursor-pointer';
        codeBtn.className = 'px-2.5 py-1 rounded-md text-slate-400 hover:text-white cursor-pointer';
      } else {
        iframe.classList.add('hidden');
        codeArea.classList.remove('hidden');
        codeBtn.className = 'px-2.5 py-1 rounded-md bg-violet-600 text-white font-semibold cursor-pointer';
        prevBtn.className = 'px-2.5 py-1 rounded-md text-slate-400 hover:text-white cursor-pointer';
      }
    }

    function downloadGeneratedSite() {
      if (!appState.currentGeneratedHtml) return;
      const slug = (appState.currentGeneratedTitle || 'antimatter-site').toLowerCase().replace(/[^a-z0-9]+/g, '-');
      const blob = new Blob([appState.currentGeneratedHtml], { type: 'text/html' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `${slug}.html`;
      a.click();
      URL.revokeObjectURL(url);
      showToast(`Downloaded ${slug}.html`);
    }

    /* ============================================================================
       LIBRARY & TOOLS DIRECTORY
       ============================================================================ */
    function saveGeneratedSiteToLibrary() {
      if (!appState.currentGeneratedHtml) return;
      appState.library.unshift({
        id: 'item-' + Date.now(),
        type: 'website',
        title: appState.currentGeneratedTitle || 'Untitled Website',
        createdAt: new Date().toLocaleDateString(),
        html: appState.currentGeneratedHtml
      });
      localStorage.setItem(STORAGE_KEYS.LIBRARY, JSON.stringify(appState.library));
      renderLibrary();
      updateComputeIndicators();
      showToast('Saved website draft to My Library!');
    }

    function saveCurrentChatToLibrary() {
      if (!appState.chatHistory.length) {
        showToast('Start a conversation first before saving.');
        return;
      }
      const firstUser = appState.chatHistory.find(m => m.role === 'user')?.content || 'AI Research Session';
      appState.library.unshift({
        id: 'chat-' + Date.now(),
        type: 'chat',
        title: firstUser.slice(0, 48) + (firstUser.length > 48 ? '...' : ''),
        createdAt: new Date().toLocaleDateString(),
        messages: [...appState.chatHistory]
      });
      localStorage.setItem(STORAGE_KEYS.LIBRARY, JSON.stringify(appState.library));
      renderLibrary();
      updateComputeIndicators();
      showToast('Saved AI chat session to My Library!');
    }

    function renderLibrary() {
      const container = document.getElementById('library-content');
      if (!container) return;

      if (!appState.library.length) {
        container.innerHTML = `
          <div class="col-span-full glass-panel rounded-3xl p-12 text-center space-y-3">
            <div class="text-3xl">▤</div>
            <h3 class="font-display font-bold text-lg">Your Antimatter Vault is ready</h3>
            <p class="text-xs max-w-md mx-auto" style="color: var(--text-secondary)">
              Website drafts and AI chat sessions you save will appear here for instant reload or export.
            </p>
            <button onclick="navigateTo('builder')" class="antimatter-btn px-5 py-2.5 rounded-xl text-xs font-semibold mt-2 cursor-pointer">
              Build your first website →
            </button>
          </div>
        `;
        return;
      }

      container.innerHTML = appState.library.map(item => `
        <div class="glass-panel rounded-2xl p-5 flex flex-col justify-between space-y-4">
          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded ${item.type === 'website' ? 'bg-fuchsia-500/15 text-fuchsia-300' : 'bg-cyan-500/15 text-cyan-300'}">
                ${item.type === 'website' ? '▧ WEBSITE DRAFT' : '◈ AI SESSION'}
              </span>
              <span class="text-[11px] font-mono" style="color: var(--text-muted)">${item.createdAt}</span>
            </div>
            <h3 class="font-display font-bold text-base truncate">${escapeHtml(item.title)}</h3>
            <p class="text-xs" style="color: var(--text-secondary)">
              ${item.type === 'website' ? 'Standalone responsive HTML5 draft ready to preview or download.' : `${item.messages?.length || 0} messages preserved in local storage.`}
            </p>
          </div>
          <div class="flex items-center gap-2 pt-2 border-t border-white/10">
            <button onclick="openLibraryItem('${item.id}')" class="flex-1 py-2 rounded-xl bg-white/10 hover:bg-violet-600 hover:text-white text-xs font-semibold transition-colors cursor-pointer">
              Open in Workspace
            </button>
            <button onclick="deleteLibraryItem('${item.id}')" class="p-2 rounded-xl text-xs text-slate-400 hover:text-rose-400 cursor-pointer" title="Delete">
              ✕
            </button>
          </div>
        </div>
      `).join('');
    }

    function openLibraryItem(id) {
      const item = appState.library.find(i => i.id === id);
      if (!item) return;

      if (item.type === 'website') {
        appState.currentGeneratedHtml = item.html;
        appState.currentGeneratedTitle = item.title;
        navigateTo('builder');
        document.getElementById('site-preview').srcdoc = item.html;
        document.getElementById('site-code-view').value = item.html;
        document.getElementById('preview-empty').classList.add('hidden');
        document.getElementById('save-site-btn').disabled = false;
        document.getElementById('download-site-btn').disabled = false;
        showToast(`Loaded "${item.title}" into Web Builder`);
      } else if (item.type === 'chat') {
        navigateTo('chat');
        const thread = document.getElementById('chat-thread');
        thread.innerHTML = '';
        appState.chatHistory = item.messages || [];
        appState.chatHistory.forEach(m => {
          if (m.role === 'user') {
            appendUserBubble(m.content);
          } else {
            const div = document.createElement('div');
            div.className = 'glass-panel rounded-2xl p-4 text-sm space-y-1 max-w-3xl';
            div.innerHTML = `<div class="text-xs font-mono text-cyan-300">${escapeHtml(m.provider || 'AI')}</div><div class="chat-prose">${formatMarkdown(m.content)}</div>`;
            thread.appendChild(div);
          }
        });
        showToast('Restored AI chat session');
      }
    }

    function deleteLibraryItem(id) {
      appState.library = appState.library.filter(i => i.id !== id);
      localStorage.setItem(STORAGE_KEYS.LIBRARY, JSON.stringify(appState.library));
      renderLibrary();
      updateComputeIndicators();
      showToast('Removed item from Library');
    }

    function setToolCategory(cat) {
      appState.selectedToolCategory = cat;
      document.querySelectorAll('.tool-cat-btn').forEach(btn => {
        if (btn.dataset.cat === cat) {
          btn.className = 'tool-cat-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-violet-600 text-white cursor-pointer';
        } else {
          btn.className = 'tool-cat-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold glass-panel cursor-pointer';
        }
      });
      renderToolsDirectory();
    }

    function renderToolsDirectory() {
      const grid = document.getElementById('tools-grid');
      if (!grid) return;
      const query = (document.getElementById('tool-search')?.value || '').toLowerCase();

      const filtered = TOOLS_DIRECTORY.filter(t => {
        const matchCat = appState.selectedToolCategory === 'All' || t.category === appState.selectedToolCategory;
        const matchQuery = t.name.toLowerCase().includes(query) || t.desc.toLowerCase().includes(query) || t.tag.toLowerCase().includes(query);
        return matchCat && matchQuery;
      });

      grid.innerHTML = filtered.map(tool => {
        const isPinned = appState.pinnedToolIds.includes(tool.id);
        return `
          <div class="glass-panel rounded-2xl p-5 flex flex-col justify-between space-y-4">
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-white/10 text-cyan-300">${tool.tag}</span>
                <button onclick="togglePinTool('${tool.id}')" class="text-xs px-2 py-0.5 rounded ${isPinned ? 'text-amber-300 bg-amber-500/15' : 'text-slate-400 hover:text-white'} cursor-pointer" title="Pin to sidebar">
                  ${isPinned ? '★ Pinned' : '☆ Pin'}
                </button>
              </div>
              <h3 class="font-display font-bold text-base">${tool.name}</h3>
              <p class="text-xs leading-relaxed" style="color: var(--text-secondary)">${tool.desc}</p>
            </div>
            <a href="${tool.url}" target="_blank" rel="noreferrer" class="w-full py-2 rounded-xl bg-white/5 hover:bg-violet-600 hover:text-white border border-white/10 text-center text-xs font-semibold transition-colors">
              Launch ${tool.name} ↗
            </a>
          </div>
        `;
      }).join('');
    }

    function togglePinTool(toolId) {
      if (appState.pinnedToolIds.includes(toolId)) {
        appState.pinnedToolIds = appState.pinnedToolIds.filter(id => id !== toolId);
      } else {
        appState.pinnedToolIds.push(toolId);
      }
      localStorage.setItem(STORAGE_KEYS.PINNED, JSON.stringify(appState.pinnedToolIds));
      renderPinnedTools();
      renderToolsDirectory();
      showToast('Updated sidebar launchers');
    }

    function renderPinnedTools() {
      const container = document.getElementById('pinned-tools-list');
      if (!container) return;
      const pinned = TOOLS_DIRECTORY.filter(t => appState.pinnedToolIds.includes(t.id));
      container.innerHTML = pinned.map(t => `
        <a href="${t.url}" target="_blank" rel="noreferrer" class="flex items-center justify-between px-2.5 py-2 rounded-xl text-xs hover:bg-white/5 transition-colors" style="color: var(--text-secondary)">
          <span class="flex items-center gap-2 font-medium">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
            ${t.name}
          </span>
          <span class="text-[11px] opacity-60">↗</span>
        </a>
      `).join('');
    }

    function renderHomeModelsStrip() {
      const strip = document.getElementById('home-models-strip');
      if (!strip) return;
      const items = [
        { name: 'ChatGPT 4o', sub: 'OpenAI', dot: 'bg-emerald-400' },
        { name: 'Gemini 2.5', sub: 'Google', dot: 'bg-cyan-400' },
        { name: 'Claude 3.7', sub: 'Anthropic', dot: 'bg-amber-400' },
        { name: 'Grok 3', sub: 'xAI', dot: 'bg-slate-200' },
        { name: 'DeepSeek R1', sub: 'Reasoning', dot: 'bg-blue-400' },
        { name: 'My GPU Node', sub: 'Ollama / vLLM', dot: 'bg-violet-400' }
      ];
      strip.innerHTML = items.map(i => `
        <div onclick="navigateTo('chat')" class="glass-panel rounded-2xl p-3.5 flex items-center gap-3 cursor-pointer">
          <span class="w-2.5 h-2.5 rounded-full ${i.dot} shrink-0"></span>
          <div class="min-w-0">
            <div class="text-xs font-bold truncate">${i.name}</div>
            <div class="text-[10px] font-mono" style="color: var(--text-muted)">${i.sub}</div>
          </div>
        </div>
      `).join('');
    }

    /* ============================================================================
       COMMAND PALETTE (CMD+K) & UTILITIES
       ============================================================================ */
    const COMMAND_ACTIONS = [
      { label: 'All-in-One AI Chat (ChatGPT, Gemini, Claude, GPU)', action: () => navigateTo('chat') },
      { label: 'GPU & API Keys Vault (Add Keys or Ollama Endpoint)', action: () => navigateTo('compute') },
      { label: 'Antimatter Website Builder (Generate HTML)', action: () => navigateTo('builder') },
      { label: 'Explore 16+ AI Tools Directory', action: () => navigateTo('tools') },
      { label: 'My Saved Library & Website Drafts', action: () => navigateTo('library') },
      { label: 'Toggle Multi-AI Council Compare Mode', action: () => { navigateTo('chat'); toggleCouncilMode(); } },
      { label: 'Switch Dark / Light Glass Theme', action: () => toggleTheme() }
    ];

    function openCommandModal() {
      const modal = document.getElementById('cmd-modal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      const input = document.getElementById('cmd-search-input');
      input.value = '';
      filterCommandItems();
      setTimeout(() => input.focus(), 50);
    }

    function closeCommandModal() {
      const modal = document.getElementById('cmd-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    function filterCommandItems() {
      const q = (document.getElementById('cmd-search-input').value || '').toLowerCase();
      const list = document.getElementById('cmd-list');
      const matches = COMMAND_ACTIONS.filter(c => c.label.toLowerCase().includes(q));
      list.innerHTML = matches.map((c, idx) => `
        <button onclick="runCommandIndex(${idx})" class="w-full text-left px-3.5 py-2.5 rounded-xl hover:bg-violet-600/25 flex items-center justify-between transition-colors cursor-pointer">
          <span>${c.label}</span>
          <span class="text-xs font-mono text-cyan-400">↵</span>
        </button>
      `).join('');
      window._filteredCommands = matches;
    }

    function runCommandIndex(idx) {
      const cmd = window._filteredCommands?.[idx];
      closeCommandModal();
      if (cmd) cmd.action();
    }

    function escapeHtml(str) {
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function formatMarkdown(text) {
      let safe = escapeHtml(text);
      // Code blocks
      safe = safe.replace(/```([\s\S]*?)```/g, '<pre><code>$1</code></pre>');
      // Inline code
      safe = safe.replace(/`([^`]+)`/g, '<code>$1</code>');
      // Bold
      safe = safe.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
      // Line breaks
      safe = safe.replace(/\n/g, '<br/>');
      return safe;
    }
  </script>
</body>
