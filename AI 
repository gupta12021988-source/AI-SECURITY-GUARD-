    async function handleBuildWebsite(e) {
      e.preventDefault();
      const name = document.getElementById('site-name').value.trim();
      const desc = document.getElementById('site-description').value.trim();
      const style = document.querySelector('input[name="style"]:checked')?.value || 'antimatter';
      const engine = document.getElementById('builder-engine').value;

      if (!name || !desc) return;

      const btn = document.getElementById('builder-submit-btn');
      btn.disabled = true;
      btn.innerHTML = '<span>✦</span> Synthesizing Antimatter Site...';

      let htmlCode = '';

      if (engine === 'ai-live') {
        const aiPrompt = `Create a complete, single-file responsive HTML5 landing page using Tailwind CDN (<script src="https://cdn.tailwindcss.com"><\/script>) for "${name}". Description: ${desc}. Theme style: ${style}. Return ONLY raw HTML starting with <!doctype html> and no markdown fences.`;
        const providerId = document.getElementById('provider-select').value;
        const res = await queryModelEngine(providerId, aiPrompt);
        const cleaned = res.text.replace(/^```html\s*/i, '').replace(/```\s*$/i, '').trim();
        if (cleaned.toLowerCase().includes('<html')) {
          htmlCode = cleaned;
        }
      }

      if (!htmlCode) {
        htmlCode = generateAntimatterWebsiteTemplate(name, desc, style);
      }

      appState.currentGeneratedHtml = htmlCode;
      appState.currentGeneratedTitle = name;

      const iframe = document.getElementById('site-preview');
      const codeArea = document.getElementById('site-code-view');
      const emptyOverlay = document.getElementById('preview-empty');

      iframe.srcdoc = htmlCode;
      codeArea.value = htmlCode;
      emptyOverlay.classList.add('hidden');

      document.getElementById('save-site-btn').disabled = false;
      document.getElementById('download-site-btn').disabled = false;

      btn.disabled = false;
      btn.innerHTML = '<span>✦</span> Generate Future-Ready Website <span>→</span>';
      showToast(`Synthesized "${name}" website draft!`);
    }

