    function getProviderDisplayName(providerId) {
      if (providerId.startsWith('gpu:')) {
        const node = appState.gpuNodes.find(n => n.id === providerId.replace('gpu:', ''));
        return node ? `⚡ ${node.name}` : 'Custom GPU Node';
      }
      if (providerId === 'custom-gpu') {
        const active = getActiveGpuNode();
        return active ? `⚡ ${active.name}` : 'Custom GPU Node';
      }
      const found = AI_PROVIDERS.find(p => p.id === providerId);
      if (found) return found.name;
      if (providerId === 'meta') return 'Meta Llama 3.3 70B';
      return providerId.toUpperCase();
    }

    /* ============================================================================
       UNIFIED LIVE API + LOCAL GPU + SMART FALLBACK QUERY ENGINE
       ============================================================================ */
    async function queryModelEngine(providerId, prompt) {
      try {
        // 1. Custom GPU Node (Ollama / vLLM / LM Studio)
        if (providerId.startsWith('gpu:') || providerId === 'custom-gpu') {
          const gpuId = providerId.startsWith('gpu:') ? providerId.replace('gpu:', '') : appState.activeGpuId;
          const node = appState.gpuNodes.find(n => n.id === gpuId) || getActiveGpuNode();
          if (node && node.url) {
            const headers = { 'Content-Type': 'application/json' };
            if (node.token) headers['Authorization'] = `Bearer ${node.token}`;
            const res = await fetch(node.url, {
              method: 'POST',
              headers,
              body: JSON.stringify({
                model: node.model || 'llama3.2',
                messages: [{ role: 'user', content: prompt }],
                temperature: 0.7
              })
            });
            if (res.ok) {
              const data = await res.json();
              const reply = data.choices?.[0]?.message?.content || data.response || JSON.stringify(data);
              return { text: reply, source: `LIVE GPU (${node.model})` };
            }
          }
          return {
            text: generateSmartSimulatedReply(providerId, prompt, true),
            source: 'GPU Sim (Start Ollama/vLLM with CORS)'
          };
        }

        // 2. Google Gemini Live REST API
        if (providerId === 'gemini' && appState.apiKeys.gemini) {
          const key = appState.apiKeys.gemini;
          const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${encodeURIComponent(key)}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              contents: [{ parts: [{ text: prompt }] }]
            })
          });
          if (res.ok) {
            const data = await res.json();
            const reply = data.candidates?.[0]?.content?.parts?.[0]?.text;
            if (reply) return { text: reply, source: 'LIVE GEMINI API' };
          }
        }

        // 3. OpenAI / DeepSeek / Perplexity / Grok / Kimi / OpenRouter compatible endpoints
        const endpointMap = {
          openai: { url: 'https://api.openai.com/v1/chat/completions', model: 'gpt-4o-mini', key: appState.apiKeys.openai },
          deepseek: { url: 'https://api.deepseek.com/chat/completions', model: 'deepseek-chat', key: appState.apiKeys.deepseek },
          perplexity: { url: 'https://api.perplexity.ai/chat/completions', model: 'sonar', key: appState.apiKeys.perplexity },
          grok: { url: 'https://api.x.ai/v1/chat/completions', model: 'grok-2-latest', key: appState.apiKeys.grok },
          kimi: { url: 'https://api.moonshot.cn/v1/chat/completions', model: 'moonshot-v1-8k', key: appState.apiKeys.kimi }
        };

        const config = endpointMap[providerId];
        if (config && config.key) {
          const res = await fetch(config.url, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${config.key}`
            },
            body: JSON.stringify({
              model: config.model,
              messages: [{ role: 'user', content: prompt }]
            })
          });
          if (res.ok) {
            const data = await res.json();
            const reply = data.choices?.[0]?.message?.content;
            if (reply) return { text: reply, source: 'LIVE API' };
          }
        }

        // 4. OpenRouter Fallback if user provided an OpenRouter key
        if (appState.apiKeys.openrouter) {
          const orModels = {
            claude: 'anthropic/claude-3.7-sonnet',
            meta: 'meta-llama/llama-3.3-70b-instruct',
            openai: 'openai/gpt-4o',
            gemini: 'google/gemini-2.5-pro-exp-03-25',
            deepseek: 'deepseek/deepseek-r1',
            grok: 'x-ai/grok-2-1212'
          };
          const res = await fetch('https://openrouter.ai/api/v1/chat/completions', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${appState.apiKeys.openrouter}`
            },
            body: JSON.stringify({
              model: orModels[providerId] || 'meta-llama/llama-3.3-70b-instruct',
              messages: [{ role: 'user', content: prompt }]
            })
          });
          if (res.ok) {
            const data = await res.json();
            const reply = data.choices?.[0]?.message?.content;
            if (reply) return { text: reply, source: 'LIVE OPENROUTER' };
          }
        }
      } catch (err) {
        console.warn('Live API call fell back to Antimatter Sim:', err);
      }

      // 5. Intelligent Simulated Fallback (Zero-Setup Experience)
      await new Promise(r => setTimeout(r, 550 + Math.random() * 450));
      return {
        text: generateSmartSimulatedReply(providerId, prompt, false),
        source: 'Antimatter Smart Sim'
      };
    }

    function generateSmartSimulatedReply(providerId, prompt, isGpu) {
      const persona = {
        openai: '**ChatGPT (GPT-4o) Perspective:** Here is a structured, actionable blueprint tailored to your request.',
        gemini: '**Gemini 2.5 Pro Synthesis:** Combining multimodal context and ecosystem scalability for your objective.',
        claude: '**Claude 3.7 Sonnet Analysis:** Let’s break this down cleanly with architectural clarity and edge-case precision.',
        deepseek: '**DeepSeek R1 Reasoning Trace:** Evaluating optimal system efficiency, latency bounds, and implementation steps.',
        grok: '**xAI Grok Real-Time Take:** Straight to the point—cutting through noise for maximum execution speed.',
        perplexity: '**Perplexity Sonar Brief:** Synthesizing verified best practices and modern industry benchmarks.'
      }[providerId] || (isGpu ? '**Local GPU Node Inference:** Executing sovereign zero-data-leak response on your dedicated hardware.' : '**Antimatter AI Core:** Unified synthesis ready.');

      return `${persona}\n\nRegarding **"${prompt.slice(0, 110)}${prompt.length > 110 ? '...' : ''}"**:\n\n1. **Core Architecture:** Decouple your frontend state from inference routing so you can switch seamlessly between cloud frontier models and local GPU nodes.\n2. **Next-Gen Execution:** Use streaming responses and edge caching to achieve sub-200ms perceived latency.\n3. **Ready to Build:** Want me to turn this concept into a live, downloadable webpage? Open **Antimatter Web Builder** in the sidebar.\n\n*Tip: Add your live API key or start your local Ollama/vLLM server in **GPU & API Keys** for real-time model weights.*`;
    }

