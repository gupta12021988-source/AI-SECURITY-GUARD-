  <!-- COMMAND PALETTE MODAL (CMD+K) -->
  <div id="cmd-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/70 backdrop-blur-md" onclick="if(event.target===this) closeCommandModal()">
