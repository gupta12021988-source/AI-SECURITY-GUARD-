  <!-- TOAST NOTIFICATION -->
  <div id="toast" role="status" class="fixed bottom-5 right-5 z-50 transform translate-y-20 opacity-0 pointer-events-none transition-all duration-300 glass-panel px-4 py-3 rounded-2xl border border-cyan-400/40 shadow-2xl flex items-center gap-2.5 text-xs sm:text-sm font-medium">
    <span class="text-cyan-400">✦</span>
    <span id="toast-msg">Ready</span>
  </div>

  <script>
    /* ============================================================================
       STATE & CONFIGURATION
       ============================================================================ */
    const STORAGE_KEYS = {
      API_KEYS: 'nl_antimatter_api_keys_v1',
      GPU_NODES: 'nl_antimatter_gpu_nodes_v1',
      ACTIVE_GPU: 'nl_antimatter_active_gpu_v1',
      LIBRARY: 'nl_antimatter_library_v1',
      PINNED: 'nl_antimatter_pinned_v1',
      THEME: 'nl_antimatter_theme_v1'
    };

    const AI_PROVIDERS = [
      { id: 'openai', name: 'OpenAI (ChatGPT)', model: 'gpt-4o', badge: 'GPT-4o', color: 'text-emerald-400', placeholder: 'sk-proj-...' },
      { id: 'gemini', name: 'Google Gemini', model: 'gemini-2.5-flash', badge: '2.5 Pro/Flash', color: 'text-cyan-400', placeholder: 'AIzaSy...' },
      { id: 'claude', name: 'Anthropic Claude', model: 'claude-3-7-sonnet-20250219', badge: 'Sonnet 3.7', color: 'text-amber-400', placeholder: 'sk-ant-...' },
      { id: 'perplexity', name: 'Perplexity Sonar', model: 'sonar-pro', badge: 'Web Search', color: 'text-teal-400', placeholder: 'pplx-...' },
      { id: 'grok', name: 'xAI Grok', model: 'grok-2-latest', badge: 'Grok 3', color: 'text-slate-200', placeholder: 'xai-...' },
      { id: 'deepseek', name: 'DeepSeek', model: 'deepseek-chat', badge: 'R1 / V3', color: 'text-blue-400', placeholder: 'sk-...' },
      { id: 'kimi', name: 'Moonshot Kimi', model: 'moonshot-v1-8k', badge: 'Kimi k1.5', color: 'text-violet-400', placeholder: 'sk-...' },
      { id: 'openrouter', name: 'OpenRouter (All Models)', model: 'meta-llama/llama-3.3-70b-instruct', badge: '100+ LLMs', color: 'text-fuchsia-400', placeholder: 'sk-or-...' }
    ];

    const TOOLS_DIRECTORY = [
      { id: 'chatgpt', name: 'ChatGPT', category: 'Chat', url: 'https://chatgpt.com', desc: 'OpenAI flagship reasoning, coding & multimodal workspace.', tag: 'GPT-4o / o3' },
      { id: 'gemini', name: 'Google Gemini', category: 'Chat', url: 'https://gemini.google.com', desc: 'Deep Google ecosystem research, 1M+ context & multimodal AI.', tag: 'Gemini 2.5' },
      { id: 'claude', name: 'Claude', category: 'Chat', url: 'https://claude.ai', desc: 'Anthropic frontier model for nuanced writing, artifacts & code.', tag: 'Claude 3.7' },
      { id: 'perplexity', name: 'Perplexity AI', category: 'Research', url: 'https://www.perplexity.ai', desc: 'Real-time cited web answer engine and deep research assistant.', tag: 'Live Citations' },
      { id: 'deepseek', name: 'DeepSeek', category: 'Code', url: 'https://chat.deepseek.com', desc: 'Open-weights reasoning powerhouse for math, logic & algorithms.', tag: 'DeepSeek R1' },
      { id: 'grok', name: 'xAI Grok', category: 'Chat', url: 'https://grok.com', desc: 'Real-time social pulse & high-speed reasoning assistant.', tag: 'Grok 3' },
      { id: 'kimi', name: 'Kimi AI', category: 'Research', url: 'https://kimi.moonshot.cn', desc: 'Ultra-long context document analyzer and synthesis assistant.', tag: 'Long Context' },
      { id: 'cursor', name: 'Cursor AI', category: 'Code', url: 'https://cursor.com', desc: 'AI-first code editor built for rapid full-stack engineering.', tag: 'AI IDE' },
      { id: 'v0', name: 'Vercel v0', category: 'Code', url: 'https://v0.dev', desc: 'Generative UI system for React, Tailwind & Next.js components.', tag: 'UI Gen' },
      { id: 'midjourney', name: 'Midjourney', category: 'Media', url: 'https://www.midjourney.com', desc: 'Photorealistic & artistic generative image synthesis.', tag: 'Image' },
      { id: 'runway', name: 'Runway Gen-3', category: 'Media', url: 'https://runwayml.com', desc: 'Cinematic AI video generation and visual effects studio.', tag: 'Video' },
      { id: 'elevenlabs', name: 'ElevenLabs', category: 'Media', url: 'https://elevenlabs.io', desc: 'Ultra-realistic AI voice synthesis and dubbing studio.', tag: 'Voice' },
      { id: 'ollama', name: 'Ollama Local GPU', category: 'GPU', url: 'https://ollama.com', desc: 'Run Llama 3, DeepSeek & Qwen locally on your own NVIDIA/Mac GPU.', tag: 'Local Runtime' },
      { id: 'huggingface', name: 'Hugging Face', category: 'GPU', url: 'https://huggingface.co', desc: 'Open-source model hub, datasets, and inference endpoints.', tag: 'Open Weights' },
      { id: 'runpod', name: 'RunPod GPU Cloud', category: 'GPU', url: 'https://www.runpod.io', desc: 'On-demand H100 & RTX 4090 cloud GPU pods for vLLM.', tag: 'Cloud GPU' },
      { id: 'openrouter', name: 'OpenRouter', category: 'Code', url: 'https://openrouter.ai', desc: 'Unified API gateway to 200+ frontier and open-source models.', tag: 'Unified API' }
    ];

    let appState = {
      apiKeys: {},
      gpuNodes: [],
      activeGpuId: null,
      library: [],
      pinnedToolIds: ['chatgpt', 'gemini', 'claude', 'ollama'],
      councilMode: false,
      chatHistory: [],
      currentGeneratedHtml: '',
      currentGeneratedTitle: '',
      selectedToolCategory: 'All'
    };

    /* ============================================================================
       INITIALIZATION
       ============================================================================ */
    window.addEventListener('DOMContentLoaded', () => {
      loadPersistedState();
      updateDateDisplay();
      renderPinnedTools();
      renderHomeModelsStrip();
      renderApiKeysForm();
      renderGpuNodes();
      renderToolsDirectory();
      renderLibrary();
      updateComputeIndicators();
      onProviderChange();

      // Keyboard shortcut Cmd/Ctrl + K
      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          openCommandModal();
        } else if (e.key === 'Escape') {
          closeCommandModal();
        }
      });
    });

    function loadPersistedState() {
      try {
        const keys = localStorage.getItem(STORAGE_KEYS.API_KEYS);
        if (keys) appState.apiKeys = JSON.parse(keys);

        const gpus = localStorage.getItem(STORAGE_KEYS.GPU_NODES);
        if (gpus) {
          appState.gpuNodes = JSON.parse(gpus);
        } else {
          // Provide a helpful pre-configured template node for Ollama
          appState.gpuNodes = [
            {
              id: 'gpu-local-ollama',
              name: 'Local Workstation GPU (Ollama)',
              url: 'http://localhost:11434/v1/chat/completions',
              model: 'llama3.2',
              vram: 'Local GPU / Apple Silicon',
              token: ''
            }
          ];
        }

        const activeGpu = localStorage.getItem(STORAGE_KEYS.ACTIVE_GPU);
        appState.activeGpuId = activeGpu || (appState.gpuNodes[0] ? appState.gpuNodes[0].id : null);

        const lib = localStorage.getItem(STORAGE_KEYS.LIBRARY);
        if (lib) appState.library = JSON.parse(lib);

        const pinned = localStorage.getItem(STORAGE_KEYS.PINNED);
        if (pinned) appState.pinnedToolIds = JSON.parse(pinned);

        const theme = localStorage.getItem(STORAGE_KEYS.THEME);
        if (theme === 'light') {
          document.documentElement.classList.add('light-theme');
          document.getElementById('theme-toggle-btn').textContent = '☾';
        }
      } catch (err) {
        console.error('State load error:', err);
      }
    }

    function updateDateDisplay() {
      const el = document.getElementById('today-date');
      if (!el) return;
      const now = new Date();
      el.textContent = now.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' });
    }

    /* ============================================================================
       NAVIGATION & THEME
       ============================================================================ */
    function navigateTo(pageId) {
      const titles = {
        home: 'Overview',
        chat: 'All-in-One AI Chat',
        compute: 'GPU & API Keys Vault',
        builder: 'Antimatter Website Builder',
        tools: 'Explore AI Tools',
        library: 'My Library'
      };

      document.querySelectorAll('.page-view').forEach(p => p.classList.remove('active'));
      const target = document.getElementById(`page-${pageId}`);
      if (target) target.classList.add('active');

      document.querySelectorAll('.nav-item').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.page === pageId);
      });

      const crumb = document.getElementById('crumb-current');
      if (crumb) crumb.textContent = titles[pageId] || 'Workspace';

      toggleSidebar(false);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function toggleSidebar(open) {
      const sidebar = document.getElementById('sidebar');
      const backdrop = document.getElementById('sidebar-backdrop');
      if (open) {
        sidebar.classList.remove('-translate-x-full');
        backdrop.classList.remove('hidden');
      } else {
        sidebar.classList.add('-translate-x-full');
        backdrop.classList.add('hidden');
      }
    }

    function toggleTheme() {
      const isLight = document.documentElement.classList.toggle('light-theme');
      localStorage.setItem(STORAGE_KEYS.THEME, isLight ? 'light' : 'dark');
      document.getElementById('theme-toggle-btn').textContent = isLight ? '☾' : '☀';
      showToast(isLight ? 'Switched to Light Glass theme' : 'Switched to Antimatter Dark theme');
    }

    function showToast(message) {
      const toast = document.getElementById('toast');
      const msg = document.getElementById('toast-msg');
      msg.textContent = message;
      toast.classList.remove('translate-y-20', 'opacity-0');
      clearTimeout(window._toastTimer);
      window._toastTimer = setTimeout(() => {
        toast.classList.add('translate-y-20', 'opacity-0');
      }, 3200);
    }

    /* ============================================================================
       GPU & API KEYS VAULT LOGIC
       ============================================================================ */
    function renderApiKeysForm() {
      const container = document.getElementById('api-keys-form-grid');
      if (!container) return;

      container.innerHTML = AI_PROVIDERS.map(p => {
        const val = appState.apiKeys[p.id] || '';
        const isConnected = val.trim().length > 4;
        return `
          <div class="p-3.5 rounded-2xl bg-white/5 border ${isConnected ? 'border-emerald-500/40' : 'border-white/10'} space-y-1.5">
            <div class="flex items-center justify-between">
              <label for="key-input-${p.id}" class="text-xs font-bold ${p.color}">${p.name}</label>
              <span class="text-[10px] font-mono ${isConnected ? 'text-emerald-400' : 'text-slate-500'}">
                ${isConnected ? '● LIVE' : '○ NOT SET'}
              </span>
            </div>
            <input
              id="key-input-${p.id}"
              type="password"
              value="${escapeHtml(val)}"
              placeholder="${p.placeholder}"
              class="w-full rounded-xl px-3 py-2 text-xs font-mono bg-black/30 border border-white/10 focus:border-cyan-400 focus:outline-none"
            />
            <div class="text-[10px] font-mono" style="color: var(--text-muted)">Default: ${p.model}</div>
          </div>
        `;
      }).join('');
    }

    function saveAllComputeSettings() {
      AI_PROVIDERS.forEach(p => {
        const input = document.getElementById(`key-input-${p.id}`);
        if (input) {
          appState.apiKeys[p.id] = input.value.trim();
        }
      });
      localStorage.setItem(STORAGE_KEYS.API_KEYS, JSON.stringify(appState.apiKeys));
      renderApiKeysForm();
      updateComputeIndicators();
      onProviderChange();
      showToast('API Keys & Compute Vault saved locally!');
    }

    function addOrUpdateGpuNode() {
      const name = document.getElementById('gpu-name-input').value.trim();
      const url = document.getElementById('gpu-url-input').value.trim();
      const model = document.getElementById('gpu-model-input').value.trim() || 'llama3.2';
      const vram = document.getElementById('gpu-vram-input').value.trim() || 'Dedicated GPU';
      const token = document.getElementById('gpu-token-input').value.trim();

      if (!name || !url) {
        showToast('Please enter both GPU Node Name and Endpoint URL.');
        return;
      }

      const newNode = {
        id: 'gpu-' + Date.now(),
        name,
        url,
        model,
        vram,
        token
      };

      appState.gpuNodes.unshift(newNode);
      appState.activeGpuId = newNode.id;

      localStorage.setItem(STORAGE_KEYS.GPU_NODES, JSON.stringify(appState.gpuNodes));
      localStorage.setItem(STORAGE_KEYS.ACTIVE_GPU, appState.activeGpuId);

      // Clear inputs
      document.getElementById('gpu-name-input').value = '';
      document.getElementById('gpu-url-input').value = '';
      document.getElementById('gpu-model-input').value = '';
      document.getElementById('gpu-vram-input').value = '';
      document.getElementById('gpu-token-input').value = '';

      renderGpuNodes();
      updateComputeIndicators();
      onProviderChange();
      showToast(`Activated GPU Node: ${name}`);
    }

    function selectActiveGpu(id) {
      appState.activeGpuId = id;
      localStorage.setItem(STORAGE_KEYS.ACTIVE_GPU, id);
      renderGpuNodes();
      updateComputeIndicators();
      onProviderChange();
      const node = getActiveGpuNode();
      if (node) showToast(`Routed compute to ${node.name}`);
    }

    function deleteGpuNode(id) {
      appState.gpuNodes = appState.gpuNodes.filter(n => n.id !== id);
      if (appState.activeGpuId === id) {
        appState.activeGpuId = appState.gpuNodes[0] ? appState.gpuNodes[0].id : null;
      }
      localStorage.setItem(STORAGE_KEYS.GPU_NODES, JSON.stringify(appState.gpuNodes));
      localStorage.setItem(STORAGE_KEYS.ACTIVE_GPU, appState.activeGpuId || '');
      renderGpuNodes();
      updateComputeIndicators();
      showToast('Removed GPU node');
    }

    function getActiveGpuNode() {
      return appState.gpuNodes.find(n => n.id === appState.activeGpuId) || appState.gpuNodes[0] || null;
    }

    function renderGpuNodes() {
      const container = document.getElementById('gpu-nodes-list');
      const optgroup = document.getElementById('chat-gpu-optgroup');
      if (!container) return;

      if (appState.gpuNodes.length === 0) {
        container.innerHTML = `<div class="text-xs text-slate-400 p-3 rounded-xl bg-white/5">No GPU nodes added yet. Add your local Ollama or cloud H100 endpoint above.</div>`;
      } else {
        container.innerHTML = appState.gpuNodes.map(node => {
          const isActive = node.id === appState.activeGpuId;
          return `
            <div class="p-3.5 rounded-2xl border ${isActive ? 'border-emerald-400/50 bg-emerald-500/10' : 'border-white/10 bg-white/5'} flex items-center justify-between gap-2">
              <div class="min-w-0">
                <div class="flex items-center gap-2">
                  <span class="text-xs font-bold truncate">${escapeHtml(node.name)}</span>
                  ${isActive ? '<span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300">ACTIVE</span>' : ''}
                </div>
                <div class="text-[11px] font-mono text-cyan-300 truncate mt-0.5">${escapeHtml(node.model)} · ${escapeHtml(node.vram)}</div>
                <div class="text-[10px] font-mono truncate opacity-60">${escapeHtml(node.url)}</div>
              </div>
              <div class="flex items-center gap-1.5 shrink-0">
                ${!isActive ? `<button onclick="selectActiveGpu('${node.id}')" class="px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-white/10 hover:bg-emerald-500/20 hover:text-emerald-300 cursor-pointer">Use</button>` : ''}
                <button onclick="deleteGpuNode('${node.id}')" class="p-1.5 rounded-lg text-xs text-slate-400 hover:text-rose-400 cursor-pointer" title="Remove node">✕</button>
              </div>
            </div>
          `;
        }).join('');
      }

      if (optgroup) {
        optgroup.innerHTML = appState.gpuNodes.length
          ? appState.gpuNodes.map(n => `<option value="gpu:${n.id}">⚡ GPU: ${escapeHtml(n.name)} (${escapeHtml(n.model)})</option>`).join('')
          : `<option value="custom-gpu">⚡ My Custom GPU Node (Configure in Vault)</option>`;
      }
    }

    async function pingActiveGpu() {
      const urlInput = document.getElementById('gpu-url-input').value.trim();
      const activeNode = getActiveGpuNode();
      const targetUrl = urlInput || (activeNode ? activeNode.url : '');

      if (!targetUrl) {
        showToast('Enter a GPU endpoint URL first.');
        return;
      }

      showToast(`Pinging ${targetUrl}...`);
      try {
        const controller = new AbortController();
        const timeout = setTimeout(() => controller.abort(), 3500);
        const baseCheck = targetUrl.replace(/\/chat\/completions\/?$/, '/models');
        const res = await fetch(baseCheck, { signal: controller.signal });
        clearTimeout(timeout);
        if (res.ok) {
          showToast('✓ GPU Node Online & Reachable!');
        } else {
          showToast(`Node responded with status ${res.status} (Check CORS/Auth)`);
        }
      } catch (err) {
        showToast('Could not reach GPU endpoint (Ensure server & CORS are enabled)');
      }
    }

    function updateComputeIndicators() {
      const configuredCount = Object.values(appState.apiKeys).filter(v => v && v.trim().length > 4).length;
      const sidebarKeyBadge = document.getElementById('sidebar-key-badge');
      const vaultActiveCount = document.getElementById('vault-active-count');
      if (sidebarKeyBadge) sidebarKeyBadge.textContent = `${configuredCount} LIVE`;
      if (vaultActiveCount) vaultActiveCount.textContent = `${configuredCount} Configured`;

      const activeGpu = getActiveGpuNode();
      const sidebarGpuName = document.getElementById('sidebar-gpu-name');
      const sidebarGpuSub = document.getElementById('sidebar-gpu-sub');
      const headerStatus = document.getElementById('header-compute-status');
      const chatGpuTitle = document.getElementById('chat-side-gpu-title');
      const chatGpuEndpoint = document.getElementById('chat-side-gpu-endpoint');
      const chatGpuVram = document.getElementById('chat-side-gpu-vram');

      if (activeGpu) {
        if (sidebarGpuName) sidebarGpuName.textContent = activeGpu.name;
        if (sidebarGpuSub) sidebarGpuSub.textContent = `${activeGpu.model} · ${activeGpu.vram}`;
        if (headerStatus) headerStatus.textContent = `${configuredCount} APIs · ${activeGpu.name.split('·')[0].trim()}`;
        if (chatGpuTitle) chatGpuTitle.textContent = activeGpu.name;
        if (chatGpuEndpoint) chatGpuEndpoint.textContent = activeGpu.model;
        if (chatGpuVram) chatGpuVram.textContent = activeGpu.url;
      }

      const keysStatusEl = document.getElementById('chat-side-keys-status');
      if (keysStatusEl) {
        keysStatusEl.innerHTML = AI_PROVIDERS.slice(0, 6).map(p => {
          const hasKey = (appState.apiKeys[p.id] || '').trim().length > 4;
          return `
            <div class="flex items-center justify-between py-1 px-2 rounded-lg bg-white/5">
              <span class="truncate">${p.name.split(' ')[0]}</span>
