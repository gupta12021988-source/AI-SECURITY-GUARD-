<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>NextLevel Super AI — Network Monitor & Cyber Sentinel</title>
  
  <!-- Inline SVG Favicon -->
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Cpolygon points='50,10 90,30 90,70 50,90 10,70 10,30' fill='%2300f2fe'/%3E%3Ccircle cx='50' cy='50' r='25' fill='%2304070d'/%3E%3Ccircle cx='50' cy='50' r='10' fill='%2300f5d4'/%3E%3C/svg%3E">
  
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;800&family=Orbitron:wght@500;700;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
            orbitron: ['Orbitron', 'sans-serif'],
          },
          colors: {
            cyber: {
              bg: '#04070d',
              card: '#0a101d',
              border: '#16233d',
              hover: '#111a2e',
              accent: '#00f2fe',
              blue: '#4facfe',
              purple: '#7f53ac',
              green: '#00f5d4',
              warning: '#f7b801',
              danger: '#ff0055',
              text: '#e2e8f0',
              muted: '#64748b'
            }
          }
        }
      }
    }
  </script>
  
  <style>
    body {
      background-color: #04070d;
      color: #e2e8f0;
      font-family: 'Plus Jakarta Sans', sans-serif;
      overflow-x: hidden;
    }
    .glass-card {
      background: rgba(10, 16, 29, 0.7);
      backdrop-filter: blur(16px);
      border: 1px solid #16233d;
      box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
    }
    .glass-card-interactive {
      transition: all 0.3s ease-in-out;
    }
    .glass-card-interactive:hover {
      border-color: #00f2fe;
      box-shadow: 0 0 20px rgba(0, 242, 254, 0.15);
      transform: translateY(-2px);
    }
    .chart-container {
      position: relative;
      width: 100%;
      height: 240px;
    }
    .terminal-scroll::-webkit-scrollbar {
      width: 6px;
    }
    .terminal-scroll::-webkit-scrollbar-track {
      background: #04070d;
    }
    .terminal-scroll::-webkit-scrollbar-thumb {
      background: #16233d;
      border-radius: 4px;
    }
    
    /* Core Animations */
    .pulse-green {
      box-shadow: 0 0 0 0 rgba(0, 245, 212, 0.7);
      animation: pulseGreen 2s infinite;
    }
    @keyframes pulseGreen {
      0% { box-shadow: 0 0 0 0 rgba(0, 245, 212, 0.7); }
      70% { box-shadow: 0 0 0 10px rgba(0, 245, 212, 0); }
      100% { box-shadow: 0 0 0 0 rgba(0, 245, 212, 0); }
    }
    .pulse-red {
      box-shadow: 0 0 0 0 rgba(255, 0, 85, 0.7);
      animation: pulseRed 1.5s infinite;
    }
    @keyframes pulseRed {
      0% { box-shadow: 0 0 0 0 rgba(255, 0, 85, 0.7); }
      70% { box-shadow: 0 0 0 12px rgba(255, 0, 85, 0); }
      100% { box-shadow: 0 0 0 0 rgba(255, 0, 85, 0); }
    }

    /* VIP Dev Card Shine */
    .vip-card::before {
      content: '';
      position: absolute;
      top: 0; left: -100%;
      width: 50%; height: 100%;
      background: linear-gradient(to right, transparent, rgba(247, 184, 1, 0.2), transparent);
      transform: skewX(-20deg);
      animation: shine 4s infinite;
    }
    @keyframes shine {
      0% { left: -100%; }
      20% { left: 200%; }
      100% { left: 200%; }
    }
    
    /* Logo specific animations inside HTML SVG */
    @keyframes corePulse {
        0%, 100% { fill: #00f5d4; filter: drop-shadow(0 0 10px #00f5d4); }
        50% { fill: #00f2fe; filter: drop-shadow(0 0 20px #00f2fe); }
    }
    .core-element { animation: corePulse 3s infinite; }
  </style>
</head>
<body class="min-h-screen bg-cyber-bg text-cyber-text antialiased selection:bg-cyber-accent selection:text-cyber-bg">

  <div class="flex flex-col xl:flex-row min-h-screen">

    <!-- LEFT SIDEBAR & BRANDING -->
    <aside class="w-full xl:w-80 bg-[#060a12] border-b xl:border-b-0 xl:border-r border-cyber-border p-5 flex flex-col justify-between shrink-0 z-10 shadow-[4px_0_24px_rgba(0,0,0,0.6)]">
      <div>
        <!-- ANIMATED SVG LOGO -->
        <div class="w-full mb-8 flex justify-center items-center drop-shadow-[0_0_15px_rgba(0,242,254,0.1)]">
            <svg viewBox="0 0 400 150" class="w-full h-auto max-w-[280px]" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <filter id="glow-cyan" x="-50%" y="-50%" width="200%" height="200%">
                        <feGaussianBlur stdDeviation="3" result="blur"/>
                        <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
                    </filter>
                    <filter id="glow-blue" x="-50%" y="-50%" width="200%" height="200%">
                        <feGaussianBlur stdDeviation="5" result="blur"/>
                        <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
                    </filter>
                    <linearGradient id="text-grad" x1="0%" y1="0%" x2="0%" y2="100%">
                        <stop offset="0%" stop-color="#ffffff" />
                        <stop offset="100%" stop-color="#94a3b8" />
                    </linearGradient>
                    <linearGradient id="core-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="#00f5d4" />
                        <stop offset="100%" stop-color="#00f2fe" />
                    </linearGradient>
                </defs>
                
                <!-- ICON -->
                <g transform="translate(60, 75) scale(0.6)">
                    <circle cx="0" cy="0" r="95" fill="none" stroke="#16233d" stroke-width="2" />
                    <circle cx="0" cy="0" r="95" fill="none" stroke="#4facfe" stroke-width="4" stroke-dasharray="100 40 20 40" filter="url(#glow-blue)">
                        <animateTransform attributeName="transform" type="rotate" from="0 0 0" to="360 0 0" dur="15s" repeatCount="indefinite" />
                    </circle>
                    <circle cx="0" cy="0" r="75" fill="none" stroke="#00f2fe" stroke-width="3" stroke-dasharray="15 10 40 10 5 10" filter="url(#glow-cyan)">
                        <animateTransform attributeName="transform" type="rotate" from="360 0 0" to="0 0 0" dur="10s" repeatCount="indefinite" />
                    </circle>
                    <circle cx="0" cy="0" r="55" fill="none" stroke="#00f5d4" stroke-width="2" stroke-dasharray="2 8" opacity="0.8">
                        <animateTransform attributeName="transform" type="rotate" from="0 0 0" to="360 0 0" dur="6s" repeatCount="indefinite" />
                    </circle>
                    <polygon points="0,-30 26,-15 26,15 0,30 -26,15 -26,-15" fill="url(#core-grad)" class="core-element" opacity="0.9"/>
                    <polygon points="0,-12 10,6 -10,6" fill="#04070d">
                        <animateTransform attributeName="transform" type="rotate" from="0 0 0" to="360 0 0" dur="4s" repeatCount="indefinite" />
                    </polygon>
                </g>

                <!-- TEXT -->
                <g transform="translate(130, 70)">
                    <text x="0" y="0" font-family="'Orbitron', sans-serif" font-weight="900" font-size="34" fill="url(#text-grad)" letter-spacing="1">
                        NEXT<tspan fill="#00f2fe" filter="url(#glow-cyan)">LEVEL</tspan>
                    </text>
                    <text x="3" y="24" font-family="'Orbitron', sans-serif" font-weight="700" font-size="14" fill="#4facfe" letter-spacing="7" filter="url(#glow-blue)">
                        SUPER AI
                    </text>
                    <rect x="3" y="35" width="20" height="2" fill="#00f5d4" filter="url(#glow-cyan)"/>
                    <rect x="28" y="35" width="130" height="1" fill="#16233d" />
                </g>
            </svg>
        </div>

        <nav class="space-y-2 font-medium text-sm">
          <a href="#overview" class="flex items-center gap-3 px-4 py-3 rounded-xl bg-cyber-hover text-cyber-accent border border-cyber-accent/30 transition-all shadow-[0_0_15px_rgba(0,242,254,0.1)]">
            <div class="w-2 h-2 rounded-full bg-cyber-accent pulse-green"></div>
            <span>Global Command Center</span>
          </a>
          <a href="#speedtest" class="flex items-center gap-3 px-4 py-3 rounded-xl text-cyber-muted hover:bg-cyber-hover hover:text-white transition-all">
            <span class="text-lg">⚡</span>
            <span>AI Speed Engine</span>
          </a>
          <a href="#radar" class="flex items-center gap-3 px-4 py-3 rounded-xl text-cyber-muted hover:bg-cyber-hover hover:text-white transition-all">
            <span class="text-lg">🛡️</span>
            <span>Threat Radar</span>
          </a>
          <a href="#devices" class="flex items-center gap-3 px-4 py-3 rounded-xl text-cyber-muted hover:bg-cyber-hover hover:text-white transition-all">
            <span class="text-lg">💻</span>
            <span>Device Topology</span>
          </a>
        </nav>
      </div>

      <div class="mt-8 space-y-4">
        <!-- ABOUT THE DEVELOPER PANEL -->
        <div class="vip-card glass-card p-5 rounded-xl border border-cyber-warning/50 relative overflow-hidden bg-gradient-to-br from-[#1a1500] to-cyber-bg shadow-[0_0_20px_rgba(247,184,1,0.15)]">
            <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-cyber-warning via-[#fff3b0] to-cyber-warning"></div>
            <div class="flex items-center justify-between mb-3">
                <h3 class="text-cyber-warning font-orbitron font-bold text-[11px] uppercase tracking-widest flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-cyber-warning animate-pulse"></span> Developer Intel
                </h3>
                <span class="text-xs bg-cyber-warning/20 text-cyber-warning px-2 py-0.5 rounded font-mono font-bold border border-cyber-warning/30">VERIFIED</span>
            </div>
            
            <div class="space-y-1.5">
                <div class="font-orbitron font-bold text-lg text-white drop-shadow-md">
                    Tripurari <span class="text-cyber-accent">(VIP MAN)</span> INDIA
                </div>
                <div class="font-mono text-xs font-bold text-cyber-warning tracking-wide">
                    ONE TRILLIONS (TIGER TEAM)
                </div>
                <div class="font-mono text-xs text-cyber-green flex items-center gap-2 mt-2 pt-2 border-t border-cyber-border">
                    <span class="text-cyber-muted text-[10px] uppercase">Comms:</span>
                    <span class="font-bold">MOB 8369093027</span>
                </div>
            </div>
        </div>

        <div class="p-4 rounded-xl bg-cyber-card border border-cyber-border space-y-3">
          <div class="flex items-center justify-between text-xs text-cyber-muted">
            <span>Neural Core Status</span>
            <span class="text-cyber-green font-mono">ONLINE</span>
          </div>
          <div class="w-full bg-cyber-bg rounded-full h-1.5 overflow-hidden">
            <div class="bg-gradient-to-r from-cyber-blue to-cyber-green h-full w-[94%] rounded-full shadow-[0_0_10px_#00f5d4]"></div>
          </div>
        </div>
      </div>
    </aside>

    <!-- MAIN DASHBOARD -->
    <main class="flex-1 p-4 md:p-6 lg:p-8 space-y-6 overflow-y-auto relative z-0">
      
      <!-- Ambient background glow -->
      <div class="absolute top-0 left-1/4 w-[500px] h-[500px] bg-cyber-accent/5 rounded-full blur-[120px] -z-10 pointer-events-none"></div>

      <header class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-4 border-b border-cyber-border">
        <div>
          <div class="flex items-center gap-3">
            <h1 class="text-2xl md:text-3xl font-orbitron font-bold text-white tracking-wide drop-shadow-sm">Global Network Sentinel</h1>
            <span class="px-2.5 py-1 rounded border border-cyber-green/40 text-[10px] font-mono font-bold bg-cyber-green/10 text-cyber-green flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-cyber-green pulse-green"></span> ACTIVE
            </span>
          </div>
          <p class="text-cyber-muted text-sm mt-1.5">Autonomous anomaly interception and real-time bandwidth optimization.</p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <div class="bg-cyber-card border border-cyber-border px-3 py-2 rounded-lg text-xs font-mono shadow-inner">
            <span class="text-cyber-muted">Uplink:</span>
            <span class="text-cyber-accent font-bold ml-1">SAT-COM-ALPHA</span>
          </div>
          <button id="triggerAiScanBtn" class="px-5 py-2.5 rounded-lg bg-gradient-to-r from-cyber-blue to-cyber-accent text-[#04070d] font-orbitron font-bold text-xs tracking-wide shadow-[0_0_15px_rgba(0,242,254,0.3)] hover:opacity-90 hover:scale-[1.02] transition-all">
            INITIATE AI SWEEP
          </button>
        </div>
      </header>

      <!-- METRICS GRID -->
      <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" id="overview">
        <div class="glass-card glass-card-interactive p-5 rounded-2xl relative overflow-hidden group">
          <div class="absolute -right-6 -top-6 w-24 h-24 bg-cyber-blue/10 rounded-full blur-xl group-hover:bg-cyber-blue/20 transition-all"></div>
          <div class="flex justify-between items-start">
            <span class="text-[11px] font-bold text-cyber-muted uppercase tracking-wider">Downlink Throughput</span>
            <span class="p-1.5 rounded bg-cyber-blue/10 text-cyber-blue text-[10px] font-mono border border-cyber-blue/20">LIVE</span>
          </div>
          <div class="mt-3 flex items-baseline gap-2">
            <span class="text-3xl font-extrabold text-white font-mono drop-shadow-md" id="statDownload">1,204.5</span>
            <span class="text-xs font-medium text-cyber-muted">Mbps</span>
          </div>
          <div class="mt-2 text-[10px] text-cyber-green flex items-center gap-1.5">
            <span>▲ +24.2%</span><span class="text-cyber-muted">vs target baseline</span>
          </div>
        </div>

        <div class="glass-card glass-card-interactive p-5 rounded-2xl relative overflow-hidden group">
          <div class="absolute -right-6 -top-6 w-24 h-24 bg-cyber-green/10 rounded-full blur-xl group-hover:bg-cyber-green/20 transition-all"></div>
          <div class="flex justify-between items-start">
            <span class="text-[11px] font-bold text-cyber-muted uppercase tracking-wider">Uplink Throughput</span>
            <span class="p-1.5 rounded bg-cyber-green/10 text-cyber-green text-[10px] font-mono border border-cyber-green/20">STABLE</span>
          </div>
          <div class="mt-3 flex items-baseline gap-2">
            <span class="text-3xl font-extrabold text-white font-mono drop-shadow-md" id="statUpload">482.1</span>
            <span class="text-xs font-medium text-cyber-muted">Mbps</span>
          </div>
          <div class="mt-2 text-[10px] text-cyber-green flex items-center gap-1.5">
            <span>▲ +8.4%</span><span class="text-cyber-muted">optimal efficiency</span>
          </div>
        </div>

        <div class="glass-card glass-card-interactive p-5 rounded-2xl relative overflow-hidden group">
          <div class="flex justify-between items-start">
            <span class="text-[11px] font-bold text-cyber-muted uppercase tracking-wider">Core Latency</span>
            <span class="p-1.5 rounded bg-cyber-accent/10 text-cyber-accent text-[10px] font-mono border border-cyber-accent/20">EDGE ROUTED</span>
          </div>
          <div class="mt-3 flex items-baseline gap-2">
            <span class="text-3xl font-extrabold text-white font-mono drop-shadow-md" id="statLatency">4.2</span>
            <span class="text-xs font-medium text-cyber-muted">ms</span>
          </div>
          <div class="mt-2 text-[10px] text-cyber-muted flex items-center gap-2 font-mono">
            <span>Jitter: <strong id="statJitter" class="text-cyber-accent">0.8ms</strong></span>
            <span>Loss: <strong class="text-cyber-green">0.0%</strong></span>
          </div>
        </div>

        <div class="glass-card glass-card-interactive p-5 rounded-2xl relative overflow-hidden group">
          <div class="absolute -right-6 -top-6 w-24 h-24 bg-cyber-danger/10 rounded-full blur-xl group-hover:bg-cyber-danger/20 transition-all"></div>
          <div class="flex justify-between items-start">
            <span class="text-[11px] font-bold text-cyber-muted uppercase tracking-wider">Threats Neutralized</span>
            <span class="p-1.5 rounded bg-cyber-danger/10 text-cyber-danger text-[10px] font-mono font-bold border border-cyber-danger/30 pulse-red">DEFCON 4</span>
          </div>
          <div class="mt-3 flex items-baseline gap-2">
            <span class="text-3xl font-extrabold text-white font-mono drop-shadow-md" id="statThreats">3,892</span>
            <span class="text-xs font-medium text-cyber-muted">/ 24h</span>
          </div>
          <div class="mt-2 text-[10px] text-cyber-danger flex items-center gap-1.5 font-bold">
            <span>🛑 1 Active Block</span><span class="text-cyber-muted font-normal">in progress</span>
          </div>
        </div>
      </section>

      <!-- SPEED TEST & TRAFFIC CHARTS -->
      <section class="grid grid-cols-1 lg:grid-cols-3 gap-6" id="speedtest">
        
        <!-- Speed Gauge -->
        <div class="glass-card p-6 rounded-2xl lg:col-span-1 flex flex-col items-center justify-between text-center border-t-2 border-t-cyber-blue">
          <div class="w-full">
            <h2 class="text-sm font-orbitron font-bold text-white mb-1 tracking-wide">AI Speedometer</h2>
            <p class="text-[10px] text-cyber-muted mb-4">Multi-node continuous CDN sampling</p>
            
            <div class="relative w-full flex justify-center h-[200px] items-center">
              <canvas id="speedGaugeCanvas" width="280" height="200"></canvas>
            </div>

            <div class="grid grid-cols-3 gap-3 w-full mt-2">
              <div class="bg-cyber-bg/50 border border-cyber-border rounded-lg p-2">
                <div class="text-[9px] text-cyber-muted uppercase">Ping</div>
                <div class="text-sm font-bold font-mono text-white mt-0.5" id="gaugePing">4 ms</div>
              </div>
              <div class="bg-cyber-bg/50 border border-cyber-border rounded-lg p-2">
                <div class="text-[9px] text-cyber-muted uppercase">Down</div>
                <div class="text-sm font-bold font-mono text-cyber-blue mt-0.5" id="gaugeDown">1.2G</div>
              </div>
              <div class="bg-cyber-bg/50 border border-cyber-border rounded-lg p-2">
                <div class="text-[9px] text-cyber-muted uppercase">Up</div>
                <div class="text-sm font-bold font-mono text-cyber-green mt-0.5" id="gaugeUp">482M</div>
              </div>
            </div>
          </div>

          <button id="startSpeedTestBtn" class="mt-5 w-full py-3 rounded-lg bg-cyber-hover border border-cyber-accent/50 text-cyber-accent font-orbitron font-bold text-xs tracking-wider hover:bg-cyber-accent hover:text-[#04070d] transition-all shadow-[0_0_10px_rgba(0,242,254,0.1)]">
            EXECUTE DIAGNOSTIC
          </button>
        </div>

        <!-- Traffic Graph -->
        <div class="glass-card p-6 rounded-2xl lg:col-span-2 flex flex-col justify-between 