  <style>
    body { background-color: #02050a; color: #e2e8f0; overflow-x: hidden; }
    
    .glass-panel {
      background: var(--tw-colors-cyber-panel, rgba(10,15,30,0.75));
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid var(--tw-colors-cyber-border, #1a2b4c);
      box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
