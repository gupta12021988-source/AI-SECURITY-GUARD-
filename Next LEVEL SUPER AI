    <!-- CENTER & RIGHT: AI BRAIN & TERMINAL -->
    <div class="lg:col-span-9 space-y-6 flex flex-col">
      
      <!-- Top Row: Brain Core & 1-Click Engage -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
