    .glow-cyan { text-shadow: 0 0 10px #00f2fe; }
    .glow-green { text-shadow: 0 0 10px #00f5d4; border-color: #00f5d4; box-shadow: 0 0 15px rgba(0,245,212,0.2); }
    
    /* Terminal Scrollbar */
    .terminal-scroll::-webkit-scrollbar { width: 4px; }
    .terminal-scroll::-webkit-scrollbar-track { background: #000; }
    .terminal-scroll::-webkit-scrollbar-thumb { background: #00f2fe; border-radius: 2px; }

    /* Brain Matrix Animation */
    @keyframes matrixFade {
      0% { opacity: 1; }
      100% { opacity: 0.2; }
    }
    .hex-cell { animation: matrixFade 0.5s infinite alternate; }

    /* Engage Button Sweep */
    .btn-engage {
      background: linear-gradient(45deg, #000 0%, #1a2b4c 100%);
      position: relative;
      overflow: hidden;
      transition: all 0.3s;
    }
    .btn-engage::after {
      content: ''; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%;
      background: linear-gradient(to right, rgba(255,255,255,0) 0%, rgba(0,242,254,0.3) 50%, rgba(255,255,255,0) 100%);
      transform: rotate(30deg) translateX(-100%);
      animation: sweep 3s infinite;
    }
    @keyframes sweep {
      100% { transform: rotate(30deg) translateX(100%); }
    }
    .btn-engage:hover { box-shadow: 0 0 25px rgba(0, 242, 254, 0.6); border-color: #00f2fe; }

    /* Drag & Drop Zone */
